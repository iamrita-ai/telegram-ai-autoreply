# ══════════════════════════════════════════════════════════════════════════
#  Telegram AI Auto-Reply — configuration
#  Copy to .env for local runs, or paste these into Render's Environment tab.
# ══════════════════════════════════════════════════════════════════════════

# ── Required: Telegram ───────────────────────────────────────────────────────
# API_ID / API_HASH come from https://my.telegram.org → API development tools
API_ID=
API_HASH=
# The CONTROL bot's token from @BotFather. This is not the account that
# auto-replies — it is the remote control you send commands to.
BOT_TOKEN=
# Telegram user ids allowed to control the bot. Comma-separated.
# Find yours by forwarding any message to @userinfobot.
OWNER_IDS=

# ── Required: storage ────────────────────────────────────────────────────────
# A free MongoDB Atlas cluster is enough.
MONGO_URI=
MONGO_DB=userbot
# Encrypts the stored Telegram session. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, sessions would sit in the database in plain text.
ENCRYPTION_KEY=

# ── Required: at least one AI provider ───────────────────────────────────────
GROQ_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=

# ── Personality ──────────────────────────────────────────────────────────────
# professional | casual | romantic  — switch any time with /persona
DEFAULT_PERSONA=casual

# ── Locale ───────────────────────────────────────────────────────────────────
# Used for quiet hours, scheduled messages and the daily counter.
# NOTE: the Docker image installs the `tzdata` package for this. Without it,
# Python cannot resolve any zone name and everything silently runs on UTC —
# an 08:00 schedule would fire at 13:30 in India. Check /healthz after a
# deploy: it reports the timezone it actually resolved.
TIMEZONE=Asia/Kolkata

# ── Safety rails ─────────────────────────────────────────────────────────────
# This types from a REAL Telegram account. Telegram limits accounts that
# behave mechanically, so these caps are deliberately conservative.
# Raise them only if you know what you are doing.
PER_CHAT_COOLDOWN=4.0          # seconds between two replies in one chat
PER_CHAT_HOURLY_LIMIT=30       # replies to one chat per hour
GLOBAL_HOURLY_LIMIT=120        # replies across all chats per hour
GLOBAL_DAILY_LIMIT=500         # replies across all chats per day
NEW_CHAT_EXTRA_DELAY=3.0       # extra pause before the first reply to a new chat
DROP_WHILE_REPLYING=true       # ignore follow-ups while a reply is being written

# Pacing. Telegram judges the ACCOUNT, not the chat, so a burst spread over
# many chats is still a burst.
GLOBAL_MIN_GAP=8.0             # minimum seconds between any two outgoing messages
BURST_DELAY_STEP=2.5           # extra delay per reply sent in the last 10 minutes
BURST_DELAY_MAX=45.0           # ceiling for that penalty
NIGHT_DELAY_FACTOR=2.5         # multiply every delay during quiet hours

# Stranger guardian. Unknown senders are the highest-risk contacts: a single
# "report spam" from one of them is what actually gets accounts limited.
STRANGER_EXTRA_DELAY=25.0      # extra pause before answering someone new
STRANGER_MAX_REPLIES=3         # then stop and wait for you (/trust <id> to lift)
STRANGER_SCREENING=true        # never auto-reply to scam/phishing/ad messages

# Repetition. Sending the same text twice is the clearest spam signal there is.
DUPLICATE_WINDOW=1800          # seconds a sent message is remembered for
DUPLICATE_MEMORY=12            # how many recent messages per chat to compare
ECHO_LOOP_THRESHOLD=3          # stop replying after N identical incoming messages

# ── Conversation ─────────────────────────────────────────────────────────────
HISTORY_LIMIT=20               # turns of context sent to the model
DM_RETENTION_DAYS=14
GROUP_RETENTION_HOURS=24

# ── Feel ─────────────────────────────────────────────────────────────────────
TYPING_SPEED=0.04              # seconds per character of the reply
MAX_TYPING_TIME=6.0
REACTIONS_ENABLED=true

# ── AI tuning ────────────────────────────────────────────────────────────────
AI_TIMEOUT=25
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.85

# ── Voice replies (optional) ─────────────────────────────────────────────────
# Occasionally answer with a Telegram voice note, spoken by Groq's Orpheus
# TTS model. Off by default. You must accept the model terms once at
# console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Toggle at runtime with /voice.
VOICE_REPLIES=false
VOICE_REPLY_CHANCE=0.2         # share of eligible replies that get spoken
VOICE_NAME=hannah              # autumn | diana | hannah | austin | daniel | troy
VOICE_MAX_CHARS=200            # Groq's speech endpoint hard limit

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO
