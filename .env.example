# ══════════════════════════════════════════════════════════════════════════
#  Telegram AI Auto-Reply — configuration
#  Copy to .env for local runs, or paste these into Render's Environment tab.
# ══════════════════════════════════════════════════════════════════════════

# ── Required: Telegram ───────────────────────────────────────────────────────
# API_ID / API_HASH come from https://my.telegram.org → API development tools
API_ID=
API_HASH=
# The CONTROL bot's token from @BotFather. This is not the account that
# auto-replies — it is the remote control you send commands to.
BOT_TOKEN=
# Telegram user ids allowed to control the bot. Comma-separated.
# Find yours by forwarding any message to @userinfobot.
OWNER_IDS=

# ── Required: storage ────────────────────────────────────────────────────────
# A free MongoDB Atlas cluster is enough.
MONGO_URI=
MONGO_DB=userbot
# Encrypts the stored Telegram session. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, sessions would sit in the database in plain text.
ENCRYPTION_KEY=

# ── Required: at least one AI provider ───────────────────────────────────────
GROQ_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=

# ── Personality ──────────────────────────────────────────────────────────────
# professional | casual | romantic  — switch any time with /persona
DEFAULT_PERSONA=casual

# ── Locale ───────────────────────────────────────────────────────────────────
# Used for quiet hours, scheduled messages and the daily counter.
TIMEZONE=Asia/Kolkata

# ── Safety rails ─────────────────────────────────────────────────────────────
# This types from a REAL Telegram account. Telegram limits accounts that
# behave mechanically, so these caps are deliberately conservative.
# Raise them only if you know what you are doing.
PER_CHAT_COOLDOWN=4.0          # seconds between two replies in one chat
PER_CHAT_HOURLY_LIMIT=30       # replies to one chat per hour
GLOBAL_HOURLY_LIMIT=120        # replies across all chats per hour
GLOBAL_DAILY_LIMIT=500         # replies across all chats per day
NEW_CHAT_EXTRA_DELAY=3.0       # extra pause before the first reply to a new chat
DROP_WHILE_REPLYING=true       # ignore follow-ups while a reply is being written

# ── Conversation ─────────────────────────────────────────────────────────────
HISTORY_LIMIT=20               # turns of context sent to the model
DM_RETENTION_DAYS=14
GROUP_RETENTION_HOURS=24

# ── Feel ─────────────────────────────────────────────────────────────────────
TYPING_SPEED=0.04              # seconds per character of the reply
MAX_TYPING_TIME=6.0
REACTIONS_ENABLED=true

# ── AI tuning ────────────────────────────────────────────────────────────────
AI_TIMEOUT=25
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.85

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO
